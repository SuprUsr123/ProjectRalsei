{
  "manifest_version": 3,
  "name": "Pixel Art Auto-Draw",
  "version": "1.2.4",
  "description": "Import images into ReKindle Pixel, including KindleChat entry links, with 64×64, 128×128 and 256×256 drawing sizes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://rekindle.ink/*",
    "*://*.rekindle.ink/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Pixel Art Auto-Draw"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://rekindle.ink/*",
        "*://*.rekindle.ink/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
